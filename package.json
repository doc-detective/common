{
  "name": "doc-detective-common",
  "version": "3.6.1-dev.1",
  "description": "Shared components for Doc Detective projects.",
  "main": "src/index.js",
  "scripts": {
    "dereferenceSchemas": "node ./src/schemas/dereferenceSchemas.js",
    "build": "npm run dereferenceSchemas",

  },
  "homepage": "https://github.com/doc-detective/doc-detective-common#readme",
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.1.3",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.13.2",
    "yaml": "^2.8.2"
